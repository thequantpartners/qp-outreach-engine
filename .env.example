# Puerto del Gateway REST API y Servidor MCP SSE
PORT=3100

# Clave Maestra de Seguridad (Bearer Token exigido en headers)
API_SECRET_KEY=your_secure_api_secret_key_here

# Token Oficial de Apify para Scrapers (Obtenlo en https://console.apify.com/account/integrations)
APIFY_TOKEN=your_apify_api_token_here

# Directorio de Persistencia para Sesiones de WhatsApp (Baileys)
STORAGE_DIR=./storage

# Pausa de seguridad anti-ban por defecto (en segundos)
DEFAULT_DRIP_DELAY_SECONDS=210

# Base de Datos PostgreSQL (Railway PostgreSQL / Supabase)
# Si se deja vacío, el sistema activa automáticamente almacenamiento local en ./storage/db_fallback.json
DATABASE_URL=

# Motor de Inteligencia Artificial para el Bot de Cierre (OpenRouter)
# Obtenlo en https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Teléfono del Administrador / Dueño para recibir alertas de WhatsApp (con código de país, ej. 519XXXXXXXX)
ADMIN_WHATSAPP_PHONE=your_phone_number_here

# Identidad del Negocio
COMPANY_NAME="Mi Empresa"
MODE=client
INITIAL_NICHE=clinicas_salud # Opciones: clinicas_salud, inmobiliarias, estudios_abogados, construccion_b2b

# Meta Conversions API (CAPI v21.0) para optimización de Meta Ads (Opcional para B2C)
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Modo Autónomo (true para operar independiente)
STANDALONE_MODE=true

# Webhook opcional para notificaciones externas (Telegram, Discord, Make)
WEBHOOK_URL=
